{
  "id": "/dashboard",
  "name": "Threadline Team",
  "short_name": "Threadline",
  "description": "Products, stock, sales, expenses and orders for the Threadline team.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8f4ee",
  "theme_color": "#231d18",
  "icons": [
    { "src": "/team/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/team/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/team/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/team/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Products", "url": "/products", "icons": [{ "src": "/team/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sales", "url": "/sales", "icons": [{ "src": "/team/icon-192.png", "sizes": "192x192" }] },
    { "name": "Orders", "url": "/orders", "icons": [{ "src": "/team/icon-192.png", "sizes": "192x192" }] }
  ]
}
