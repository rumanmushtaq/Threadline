# --- Database -------------------------------------------------------------
# Any PostgreSQL works. Production default: Supabase.
#   DATABASE_URL           = Supabase pooler, transaction mode (port 6543) — used by the app
#   MIGRATION_DATABASE_URL = Supabase direct or session connection (port 5432) — used by migrations
#   e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Optional: DATABASE_CA_CERT = path to Supabase's CA certificate (Database settings > SSL) for full TLS verification.
# Neon also works (detected from *.neon.tech hosts).
# Local docker (docker compose up -d):
DATABASE_URL=postgresql://threadline:threadline@127.0.0.1:55433/threadline
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=postgresql://threadline:threadline@127.0.0.1:55433/threadline_test

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
# Which proxy header holds the real client IP (used by login/order rate limits):
#   vercel (default on Vercel) | cloudflare | nginx (X-Real-IP) | xff (right-most X-Forwarded-For; default) | none
TRUSTED_PROXY=
# Random string, at least 32 chars. Protects /api/cron/worker.
CRON_SECRET=change-me-to-a-long-random-string-0123456789

# First admin, created by `pnpm db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# --- Image storage ---------------------------------------------------------
# cloudinary (production default) | local (development) | s3 (Supabase Storage, R2, AWS S3, MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Cloudinary: Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3-compatible (optional alternative)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# --- AI images -------------------------------------------------------------
# gemini | openai
AI_IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
AI_VARIATIONS=2
